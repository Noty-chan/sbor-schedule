rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid == 'gABqRTDUcDRd4VH0lxswMIJw7B83' ||
        (
          exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.disabled != true;
    }

    match /profiles/{userId} {
      allow read: if isAdmin() || isActiveUser() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin() ||
        (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'member'
        );
      allow update: if isAdmin() ||
        (
          isActiveUser()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email'])
        );
      allow delete: if isAdmin();
    }

    match /availability/{documentId} {
      allow read: if isAdmin() ||
        (isActiveUser() && resource.data.userId == request.auth.uid);
      allow create, update: if isActiveUser()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() ||
        (isActiveUser() && resource.data.userId == request.auth.uid);
    }

    match /slots/{slotId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /responses/{responseId} {
      allow read: if isAdmin() ||
        (isActiveUser() && resource.data.userId == request.auth.uid);
      allow create, update: if isActiveUser()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() ||
        (isActiveUser() && resource.data.userId == request.auth.uid);
    }

    match /presets/{presetId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /shows/{showId} {
      allow read: if isAdmin() || isActiveUser();
      allow create, update, delete: if isAdmin();
    }
  }
}
